use flake .
use gituser

export QMK_HOME=$(pwd)/modules/qmk_firmware

qmk config user.overlay_dir=$(pwd)

# The pinned QMK fork requires an explicit keyboard path prefix. Without it,
# builddefs/build_keyboard.mk looks under a literal `""keyboards/` path and
# skips keyboard-level rules such as MCU_STARTUP.
export EXTRA_KEYBOARD_FOLDER_PATH="${QMK_HOME}"

#export JUST_WORKING_DIRECTORY="${QMK_HOME}"
#export JUSTFILE="$(pwd)/Justfile"
